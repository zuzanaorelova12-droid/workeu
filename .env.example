PORT=8787
ALLOWED_ORIGINS=            # comma-separated, only if the frontend is hosted on ANOTHER origin
TRUST_PROXY=false           # true if behind nginx/Cloudflare (uses X-Forwarded-For for rate limiting)
CACHE_TTL_S=300
RATE_LIMIT_PER_MIN=60

# Bundesagentur für Arbeit Jobsuche: unofficial public endpoint (no official API from BA).
# Bundesagentur source is switched OFF in WorkEU (leave empty). Code kept in case it is wanted later.
BA_API_KEY=

# Adzuna (register for free keys; attribution "Jobs by Adzuna" required; check their terms)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Arbeitnow free job-board API (set true to enable; check their terms)
ARBEITNOW_ENABLED=false

# AI translation for the "I don't understand" feature (optional). Key stays on the server. Model name can be changed.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-haiku-5-5
